#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck source-path=SCRIPTDIR
# Behind the "Check again" button of the app page: runs the connection checks again and
# answers with the new status.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LIB=/usr/lib/gitea-mcp
# shellcheck source=../../../../lib/gitea-mcp/common.sh
source "${LIB}/common.sh"
# shellcheck source=../../../../lib/gitea-mcp/probe.sh
source "${LIB}/probe.sh"
# shellcheck source=../../../../lib/gitea-mcp/status.sh
source "${LIB}/status.sh"

if [[ "${REQUEST_METHOD:-}" != "POST" ]]; then
  printf 'Status: 405 Method Not Allowed\r\nAllow: POST\r\n\r\n'
  exit 0
fi

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
refresh_status
